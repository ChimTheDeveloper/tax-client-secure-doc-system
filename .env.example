TAX_APP_ENVIRONMENT=development
TAX_APP_VERSION=0.3.0
TAX_APP_S3_BUCKET=tax-doc-system-chim-dev
TAX_APP_AWS_REGION=us-east-1
TAX_APP_MAX_FILE_SIZE_BYTES=5242880
TAX_APP_PRESIGNED_URL_TTL_SECONDS=300
TAX_APP_MIN_CONFIDENCE_SCORE=0.6
TAX_APP_ENABLE_AUTH=true
TAX_APP_API_KEYS=replace-with-a-secure-api-key
TAX_APP_SESSION_COOKIE_NAME=tax_app_session
TAX_APP_SESSION_DURATION_HOURS=12
TAX_APP_INVITE_DURATION_HOURS=72
TAX_APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TAX_APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secure-password
TAX_APP_BOOTSTRAP_ADMIN_NAME=Platform Admin
TAX_APP_DATABASE_PATH=data/tax_app.db
TAX_APP_LOG_LEVEL=INFO
TAX_APP_ENABLE_LOCAL_AUDIT_LOG=false
TAX_APP_ENABLE_LOCAL_RESULT_STORAGE=false
TAX_APP_LOCAL_RESULT_PATH=processed_results.json
